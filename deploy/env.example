# Copier vers /etc/amphi-replay.env (lu par le service systemd et par Caddy).
# chmod 600 : le jeton y est en clair.

# Sous-domaine court pour le QR code (enregistrement DNS A vers l'IP du VPS Infomaniak).
AMPHI_DOMAINE=q.exemple.fr

# URL publique correspondante, sans barre oblique finale (sert au QR code).
AMPHI_URL_PUBLIQUE=https://q.exemple.fr

# Jeton de la télécommande et de l'administration du quiz. Générer : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
AMPHI_JETON=remplacer-par-un-jeton-aleatoire

# Base SQLite des réponses (dossier accessible en écriture par l'utilisateur amphi).
AMPHI_BDD=/opt/amphi-replay/data/quiz.sqlite
